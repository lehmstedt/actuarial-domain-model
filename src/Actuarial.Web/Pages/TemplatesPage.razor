@using Actuarial.Application.Editing
@inherits AppComponent

<div class="page-head">
    <div>
        <h1>Templates</h1>
        <p>A template only presents tables: folders hold folders or collections, collections hold objects, and an object
           points at a library table (the same table may appear more than once). What gets computed is the template's full
           dependency closure, including tables the template does not show.</p>
    </div>
    <button class="primary" @onclick="NewTemplate">New template…</button>
</div>

<div class="@(_editing ? "" : "split")">
    @if (_editing) { }
    else if (App.IsMobile)
    {
        <div class="m-picker">
            <select value="@(Selected?.Id.Value.ToString())" @onchange="e => Pick(new TemplateId(Guid.Parse(e.Value!.ToString()!)))" aria-label="Template">
                @foreach (var t in Latest) { <option value="@t.Id.Value">@t.Name (v@(t.Version.Value))</option> }
            </select>
        </div>
    }
    else
    {
    <div class="panel tight">
        <ul class="tree">
            @foreach (var t in Latest)
            {
                <li class="obj @(Selected?.Id == t.Id && !_editing ? "active" : "")" @onclick="() => Pick(t.Id)">
                    <span>@t.Name</span><span class="faint">v@(t.Version.Value)</span>
                </li>
            }
        </ul>
    </div>
    }
    <div>
        @if (_editing)
        {
            <div class="op-panel">
                <div class="panel-head">
                    <h2>@_title</h2>
                    @{ var (built, problems) = _draft!.Build(); }
                    <div class="row"><button @onclick="() => _editing = false">Cancel</button><button class="primary" disabled="@(problems.Count > 0)" @onclick="Publish">Publish</button></div>
                </div>
                <p class="muted">What the analysis shows and in which order. Tables the shown ones read are computed even when not listed.
                    Pinning a version keeps the object on it; latest follows the library.</p>
                @if (_errors.Count > 0)
                {
                    <div class="callout bad"><b>Publish refused.</b><ul>@foreach (var e in _errors) { <li>@e</li> }</ul></div>
                }
                <div class="grid tpl-layout">
                    <div><TemplateEditor T="_draft!" Changed="() => _errors.Clear()" /></div>
                    <div>
                        <h4>Check</h4>
                        @if (problems.Count > 0)
                        {
                            <div class="callout warn"><b>To fix before publishing</b><ul>@foreach (var p in problems) { <li>@p</li> }</ul></div>
                        }
                        else if (Manifest(built!, out var closureError) is not { } closure)
                        {
                            <div class="callout bad">@closureError</div>
                        }
                        else
                        {
                            <div class="callout ok">Ready to publish as v@(_draft.Version): @_draft.Root.CountObjects() table(s) shown.</div>
                            <h4>Computed closure</h4>
                            <p class="faint" style="font-size:12.5px">Every table the shown ones depend on is computed, shown or not.</p>
                            var shownIds = built!.Objects().Select(o => o.Table.Table).ToHashSet();
                            <table class="data list"><tbody>
                            @foreach (var (id, ver) in closure.Pinned.OrderBy(p => App.Service.Library.Get(p.Key, p.Value).Name))
                            {
                                <tr><td class="left">@App.Service.Library.Get(id, ver).Name</td>
                                    <td class="left faint">v@(ver.Value)</td>
                                    <td class="left">@if (!shownIds.Contains(id)) { <span class="badge">not shown</span> }</td></tr>
                            }
                            </tbody></table>
                        }
                    </div>
                </div>
            </div>
        }
        else if (Selected is { } latest)
        {
            var shown = _version is { } v ? App.Service.Templates.Get(latest.Id, v) : latest;
            var manifest = Manifest(shown);
            <div class="panel">
                <div class="panel-head">
                    <h2>@shown.Name</h2>
                    <div class="row">
                        <div class="seg">
                            @foreach (var ver in App.Service.Templates.Versions(latest.Id))
                            { <button class="@(ver.Version == shown.Version ? "on" : "")" @onclick="() => _version = ver.Version">v@(ver.Version.Value)</button> }
                        </div>
                        <button class="primary" @onclick="Edit">Edit → new version</button>
                    </div>
                </div>
                <div class="grid two">
                    <div>
                        <h4>Tree</h4>
                        <TemplateTree Template="shown" OnSelect="o => App.OpenLibraryTable(o.Table.Table)" />
                    </div>
                    <div>
                        <h4>Computed closure (latest versions)</h4>
                        @if (manifest is null) { <div class="callout bad">The closure does not resolve.</div> }
                        else
                        {
                            var shownIds = shown.Objects().Select(o => o.Table.Table).ToHashSet();
                            <table class="data list"><tbody>
                            @foreach (var (id, ver) in manifest.Pinned.OrderBy(p => App.Service.Library.Get(p.Key, p.Value).Name))
                            {
                                <tr><td class="left"><a @onclick="() => App.OpenLibraryTable(id)">@App.Service.Library.Get(id, ver).Name</a></td>
                                    <td class="left faint">v@(ver.Value)</td>
                                    <td class="left">@if (!shownIds.Contains(id)) { <span class="badge">not shown</span> }</td></tr>
                            }
                            </tbody></table>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool _editing;
    private string _title = "";
    private TemplateDraft? _draft;
    private List<string> _errors = new();
    private TemplateVersion? _version;

    private IEnumerable<AnalysisTemplate> Latest => App.Service.Templates.TemplateIds.Select(id => App.Service.Templates.FindLatest(id)!).OrderBy(t => t.Name);
    private AnalysisTemplate? Selected => App.LibraryTemplate is { } id ? App.Service.Templates.FindLatest(id) : Latest.FirstOrDefault();

    private void Pick(TemplateId id) { App.LibraryTemplate = id; _version = null; _editing = false; }

    private ResolvedManifest? Manifest(AnalysisTemplate t) => Manifest(t, out _);

    private ResolvedManifest? Manifest(AnalysisTemplate t, out string? error)
    {
        error = null;
        try { return ManifestBuilder.Build(t, App.Service.Library); }
        catch (Exception e) when (e is InvalidOperationException or KeyNotFoundException) { error = e.Message; return null; }
    }

    private void Edit()
    {
        _draft = App.Service.EditTemplate(Selected!.Id);
        _title = $"Publish {_draft.Name} v{_draft.Version}";
        _editing = true; _errors.Clear();
    }

    private void NewTemplate()
    {
        _draft = App.Service.NewTemplate();
        _title = "New template";
        _editing = true; _errors.Clear();
    }

    private void Publish()
    {
        _errors.Clear();
        var r = App.Service.PublishTemplate(_draft!);
        if (r.Ok) { App.Toast($"Published {_draft!.Name} v{_draft.Version}."); App.LibraryTemplate = _draft.Id; _version = null; _editing = false; }
        else _errors = r.Errors.ToList();
    }
}
