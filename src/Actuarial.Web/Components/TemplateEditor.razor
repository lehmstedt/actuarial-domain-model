@inject AppState App

@* Form-based editor for a template draft. Every change is made on the TemplateDraft, which keeps the tree well formed;
   publishing (by the page, through ActuarialService) is still the only gate. *@

<div class="ted">
    <label class="field ted-name">
        <span>Template name</span>
        <input value="@Draft.Name" @oninput="e => { Draft.Name = e.Value?.ToString() ?? string.Empty; Changed(); }" placeholder="e.g. Paid and incurred" />
    </label>

    <div class="ted-tree">
        @Children(Draft.Root)
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TemplateDraft Draft { get; set; } = null!;
    [Parameter] public EventCallback OnChange { get; set; }

    private int _rev;                    // re-keys the one-shot selects so they reset after use
    private DraftNode? _confirmRemove;

    private Library Lib => App.Service.Library;
    private List<IGrouping<string, TableDefinition>> TablesByKind =>
        Lib.TableIds.Select(id => Lib.FindLatest(id)!).OrderBy(d => d.Name).GroupBy(d => d.KindLabel).OrderBy(g => g.Key).ToList();

    private void Changed() { _rev++; OnChange.InvokeAsync(); }

    private static string Icon(DraftNodeKind k) => k switch
    {
        DraftNodeKind.Folder => "📁", DraftNodeKind.Collection => "🗂", _ => "▦"
    };

    private static string Noun(DraftNodeKind k) => k.ToString().ToLowerInvariant();

    private int TableCount(DraftNode n) => n.Children.Sum(c => c.Kind == DraftNodeKind.Object ? 1 : TableCount(c));

    private RenderFragment Children(DraftNode parent) => __builder =>
    {
        <ul class="ted-list">
            @foreach (var c in parent.Children)
            {
                <li @key="c.Id">@Node(c, parent)</li>
            }
        </ul>
        <div class="ted-add">
            @if (parent.Kind == DraftNodeKind.Folder)
            {
                <button class="small" @onclick="() => AddContainer(parent, DraftNodeKind.Collection)">＋ Collection</button>
                <button class="small" @onclick="() => AddContainer(parent, DraftNodeKind.Folder)">＋ Folder</button>
                @if (parent.Children.Count == 0) { <span class="faint">Empty @(parent == Draft.Root ? "template" : "folder"): folders hold collections or other folders.</span> }
            }
            else if (parent.Kind == DraftNodeKind.Collection)
            {
                <select @key="(parent.Id, _rev)" class="ted-pick" @onchange="e => AddTable(parent, e.Value?.ToString())" aria-label="Add a table to @parent.Name">
                    <option value="">＋ Add a table…</option>
                    @foreach (var g in TablesByKind)
                    {
                        <optgroup label="@g.Key">
                            @foreach (var d in g) { <option value="@d.Id.Value">@d.Name</option> }
                        </optgroup>
                    }
                </select>
                @if (parent.Children.Count == 0) { <span class="faint">Empty collection: add the tables it shows.</span> }
            }
        </div>
    };

    private RenderFragment Node(DraftNode n, DraftNode parent) => __builder =>
    {
        var i = parent.Children.IndexOf(n);
        <div class="ted-row @Noun(n.Kind)">
            <span class="ted-ico" title="@n.Kind">@Icon(n.Kind)</span>
            <input class="ted-label" value="@n.Name" @oninput="e => { n.Name = e.Value?.ToString() ?? string.Empty; OnChange.InvokeAsync(); }"
                   placeholder="@(n.Kind == DraftNodeKind.Object ? "Label" : "Name")" aria-label="@n.Kind name" />

            @if (n.Kind == DraftNodeKind.Object)
            {
                var current = n.Table is { } tid ? Lib.FindLatest(tid) : null;
                <select class="ted-table" value="@(n.Table?.Value.ToString() ?? "")" @onchange="e => SetTable(n, e.Value?.ToString())" aria-label="Table">
                    @if (current is null) { <option value="">Choose a table…</option> }
                    @foreach (var g in TablesByKind)
                    {
                        <optgroup label="@g.Key">
                            @foreach (var d in g) { <option value="@d.Id.Value">@d.Name</option> }
                        </optgroup>
                    }
                </select>
                @if (current is not null)
                {
                    <select class="ted-ver" value="@(n.Pin?.Value.ToString() ?? "")" @onchange="e => SetPin(n, e.Value?.ToString())" aria-label="Version"
                            title="Latest follows new versions when an analysis is created; a pinned version never changes.">
                        <option value="">Latest (v@(current.Version.Value))</option>
                        @foreach (var v in Lib.Versions(current.Id).Reverse())
                        { <option value="@v.Version.Value">Pin v@(v.Version.Value)</option> }
                    </select>
                }
            }
            else
            {
                <span class="faint ted-count">@TableCount(n) table@(TableCount(n) == 1 ? "" : "s")</span>
            }

            <span class="ted-actions">
                <button class="ghost small" title="Move up" disabled="@(i == 0)" @onclick="() => { Draft.Shift(n, -1); Changed(); }">↑</button>
                <button class="ghost small" title="Move down" disabled="@(i == parent.Children.Count - 1)" @onclick="() => { Draft.Shift(n, 1); Changed(); }">↓</button>
                @{ var targets = Draft.MoveTargets(n).ToList(); }
                @if (targets.Count > 0)
                {
                    <select @key="(n.Id, _rev)" class="ted-move" @onchange="e => MoveTo(n, e.Value?.ToString())" title="Move to another @(n.Kind == DraftNodeKind.Object ? "collection" : "folder")" aria-label="Move @n.Name">
                        <option value="">⇄</option><option value="" disabled>Move to…</option>
                        @foreach (var t in targets) { <option value="@t.Id">@Draft.PathOf(t)</option> }
                    </select>
                }
                <button class="ghost small" title="Duplicate" @onclick="() => { Draft.Duplicate(n); Changed(); }">⧉</button>
                <button class="ghost small danger" title="Remove" @onclick="() => AskRemove(n)">✕</button>
            </span>
        </div>
        @if (_confirmRemove == n)
        {
            <div class="callout warn ted-confirm">
                Remove @Noun(n.Kind) <b>@n.Name</b> and the @TableCount(n) table@(TableCount(n) == 1 ? "" : "s") inside it?
                <span class="row" style="margin-top:6px">
                    <button class="small danger" @onclick="() => { Draft.Remove(n); _confirmRemove = null; Changed(); }">Remove</button>
                    <button class="small" @onclick="() => _confirmRemove = null">Keep</button>
                </span>
            </div>
        }
        @if (n.IsContainer)
        {
            <div class="ted-children">@Children(n)</div>
        }
    };

    private static string NextName(DraftNode parent, string stem)
    {
        var names = parent.Children.Select(c => c.Name).ToHashSet();
        if (!names.Contains(stem)) return stem;
        for (var k = 2; ; k++) if (!names.Contains($"{stem} {k}")) return $"{stem} {k}";
    }

    private void AddContainer(DraftNode parent, DraftNodeKind kind)
    {
        Draft.Add(parent, kind, NextName(parent, kind == DraftNodeKind.Folder ? "New folder" : "New collection"));
        Changed();
    }

    private void AskRemove(DraftNode n)
    {
        if (n.IsContainer && n.Children.Count > 0) { _confirmRemove = n; return; }
        Draft.Remove(n); Changed();
    }

    private void AddTable(DraftNode collection, string? id)
    {
        if (!Guid.TryParse(id, out var g)) return;
        Draft.AddTable(collection, Lib.FindLatest(new TableId(g))!);
        Changed();
    }

    private void SetTable(DraftNode obj, string? id)
    {
        if (!Guid.TryParse(id, out var g)) return;
        var old = obj.Table is { } t ? Lib.FindLatest(t)?.Name : null;
        Draft.SetTable(obj, Lib.FindLatest(new TableId(g))!, old);
        Changed();
    }

    private void SetPin(DraftNode obj, string? v)
    {
        obj.Pin = int.TryParse(v, out var n) ? new TableVersion(n) : null;
        Changed();
    }

    private void MoveTo(DraftNode n, string? id)
    {
        if (!Guid.TryParse(id, out var g)) return;
        var target = Draft.All().FirstOrDefault(t => t.Id == g);
        if (target is null) return;
        Draft.MoveTo(n, target);
        Changed();
    }
}
